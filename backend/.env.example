MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gamegold
JWT_SECRET=your-super-secret-jwt-key-change-this

# LLM Provider — swap model string to change provider
# Dev (free):  groq/llama-3.3-70b-versatile  → get key at console.groq.com
# Prod:        claude-sonnet-4-6              → get key at console.anthropic.com
LLM_MODEL=groq/llama-3.3-70b-versatile
LLM_API_KEY=gsk_...

# Sprite image generation (Phase 3) — optional, get a token at replicate.com
# Scripts and dialogue trees work without it; only sprites need this.
REPLICATE_API_TOKEN=

DEBUG=false

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Auth cookies — leave as-is for local dev. In prod (frontend + backend on
# different domains), set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google + GitHub sign-in — optional; a provider with empty id/secret returns 503.
# Callback URLs to register: {API_PUBLIC_URL}/auth/oauth/google/callback and
# {API_PUBLIC_URL}/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
