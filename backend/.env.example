MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gamegold
JWT_SECRET=your-super-secret-jwt-key-change-this

# LLM Provider — swap model string to change provider
# Default: anthropic/claude-haiku-4-5 (cheapest; key at console.anthropic.com)
# Upgrade:  anthropic/claude-sonnet-5 — newer models think by default; see llm_utils before switching
LLM_MODEL=anthropic/claude-haiku-4-5
LLM_API_KEY=sk-ant-...

# Free trial on LLM_API_KEY — global USD cap per UTC day (users with their own key are unlimited)
TRIAL_DAILY_BUDGET_USD=1.0
# Encrypts users' own LLM keys at rest. Empty = "bring your own key" disabled.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_SECRET=

# Sprite image generation (Phase 3) — optional, get a token at replicate.com
# Scripts and dialogue trees work without it; only sprites need this.
REPLICATE_API_TOKEN=

DEBUG=false

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Auth cookies — leave as-is for local dev. In prod (frontend + backend on
# different domains), set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google + GitHub sign-in — optional; a provider with empty id/secret returns 503.
# Callback URLs to register: {API_PUBLIC_URL}/auth/oauth/google/callback and
# {API_PUBLIC_URL}/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
